{
  "$defs": {
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "decision",
            "task",
            "constraint"
          ],
          "title": "Kind",
          "type": "string"
        },
        "topic": {
          "pattern": "^[a-z0-9-]{1,64}$",
          "title": "Topic",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "topic",
        "labels",
        "text"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "parabiont-candidate/v0.1",
      "title": "Version",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Item"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "version",
    "items"
  ],
  "title": "Candidate",
  "type": "object"
}
